# Template for the reviewed, phone-specific USB route deployment file.
#
# Do not install this file as /etc/r8q-usb-route.env and do not fill it with
# guessed values. The deployment step must generate the real file only after
# the final kernel, root UUID, BOOT image, module files, helper, and protocol
# binding have been independently hashed on the target. Dependent phone
# startup remains gated while /etc/r8q-usb-route.env is absent.

EXPECTED_KERNEL=TODO_FINAL_KERNEL_RELEASE
EXPECTED_MACHINE_ID=TODO_FINAL_MACHINE_ID
EXPECTED_ROOT_UUID=TODO_FINAL_ROOT_UUID
EXPECTED_BOOT_SHA256=TODO_FINAL_BOOT_SHA256
EXPECTED_VERMAGIC="TODO_FINAL_MODULE_VERMAGIC"
EXPECTED_GPI_SHA256=TODO_FINAL_GPI_SHA256
EXPECTED_GENI_SHA256=TODO_FINAL_GENI_SHA256
EXPECTED_HELPER_SHA256=TODO_FINAL_HELPER_SHA256
EXPECTED_PROTOCOL_SHA256=TODO_FINAL_PROTOCOL_SHA256
