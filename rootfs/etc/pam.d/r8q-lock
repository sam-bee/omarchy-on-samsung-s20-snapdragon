#%PAM-1.0
# Non-empty alarm-account PIN, with a separate screen-lock failure tally.
auth required pam_faillock.so preauth silent dir=/run/r8q-lock-faillock deny=5 fail_interval=300 unlock_time=30
auth [success=1 default=bad] pam_unix.so
auth [default=die] pam_faillock.so authfail dir=/run/r8q-lock-faillock deny=5 fail_interval=300 unlock_time=30
auth sufficient pam_faillock.so authsucc dir=/run/r8q-lock-faillock deny=5 fail_interval=300 unlock_time=30
auth required pam_deny.so
account required pam_unix.so
