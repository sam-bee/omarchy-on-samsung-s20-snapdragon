[Unit]
Description=r8q WiFi: QCA6390 over PCIe (ath11k + MHI) module load
# The WiFi modules DO live in /lib/modules, so udev would coldplug them at ~9 s
# -- which races the deliberate GPI/GENI bring-up used by the hardware-prepare
# service. r8q-wifi-blacklist.conf stops that; this service deliberately loads
# the stack only after adapter/startup preparation has completed.
#
# Order matters:
#  - phy-qcom-qmp-pcie is a MODULE. Until it loads, 1c00000.pcie sits silently
#    in /sys/kernel/debug/devices_deferred (phy not bound, no error printed).
#  - pwrseq-qcom-wcn powers the QCA6390 off the qca6390-pmu rails and drives
#    WLAN_EN/BT_EN; pci-pwrctrl-pwrseq then rescans so the endpoint enumerates.
#  - qrtr-mhi (pulls in qrtr + mhi) MUST be loaded before ath11k_pci, so the
#    driver is registered when MHI creates the IPCR channel device on entering
#    mission mode. Without it nothing binds to IPCR, QMI never starts, and
#    ath11k waits forever at "Wait for device to enter SBL or Mission mode"
#    with no error -- which looks exactly like a firmware boot failure.
Requires=r8q-hardware-prepare.service
After=r8q-hardware-prepare.service

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStartPre=/usr/bin/systemctl is-active --quiet r8q-hardware-prepare.service
# Register the modular Crypto API hash before cfg80211 verifies regulatory.db.
ExecStartPre=/usr/bin/modprobe sha256
ExecStart=/usr/bin/modprobe phy-qcom-qmp-pcie
ExecStart=/usr/bin/modprobe pwrseq-qcom-wcn
ExecStart=/usr/bin/modprobe pci-pwrctrl-pwrseq
ExecStart=/usr/local/sbin/r8q-wifi-up.sh wait-endpoint
ExecStart=/usr/bin/modprobe qrtr-mhi
ExecStart=/usr/bin/modprobe ath11k_pci
ExecStart=/usr/local/sbin/r8q-wifi-up.sh wait-phy
# Wait for ath11k to finish its firmware handoff, then disable ASPM on the
# discovered QCA endpoint when the kernel exposes the per-link controls. The
# helper never assumes a PCI BDF or a phy name and uses only sysfs controls.
ExecStartPost=/usr/local/sbin/r8q-wifi-up.sh disable-aspm
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
