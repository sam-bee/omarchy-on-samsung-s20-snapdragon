[Unit]
Description=r8q normal-user Hyprland desktop
Requires=r8q-hardware-prepare.service r8q-gpu.service r8q-touch.service r8q-battery.service seatd.service
# The standalone profile deliberately starts the battery gate before the UI;
# the desktop must never become ready against an unverified MAX77705 IRQ DT
# state or a partially initialized fuel/charger stack.
After=r8q-hardware-prepare.service r8q-gpu.service r8q-touch.service r8q-battery.service seatd.service
StartLimitIntervalSec=120
StartLimitBurst=3
ConditionPathExists=/home/alarm/.config/hypr/hyprland.lua
ConditionPathExists=/usr/share/omarchy/bin/omarchy-launch-shell
ConditionPathExists=/home/alarm/.config/omarchy/shell.json
ConditionPathExists=/home/alarm/.config/omarchy/plugins/r8q.launcher/manifest.json
ConditionPathExists=/home/alarm/.config/omarchy/plugins/r8q.launcher/BarWidget.qml

[Service]
Type=exec
User=alarm
SupplementaryGroups=video render input seat
Environment=XDG_RUNTIME_DIR=/run/r8q-desktop
Environment=R8Q_DESKTOP_CONFIG=/home/alarm/.config/hypr/hyprland.lua
RuntimeDirectory=r8q-desktop
RuntimeDirectoryMode=0700
TTYPath=/dev/tty7
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
ExecStartPre=/usr/bin/systemctl is-active --quiet r8q-hardware-prepare.service
ExecStart=/usr/local/bin/r8q-desktop-session
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
