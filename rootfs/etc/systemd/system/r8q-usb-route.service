[Unit]
Description=r8q current-boot USB route receipt witness
Requires=r8q-hardware-prepare.service
After=r8q-hardware-prepare.service
DefaultDependencies=yes
ConditionPathExists=/etc/r8q-usb-route.env

[Service]
Type=oneshot
ExecStartPre=/usr/bin/systemctl is-active --quiet r8q-hardware-prepare.service
ExecStart=/usr/local/sbin/r8q-usb-route-witness.sh
RemainAfterExit=yes
TimeoutStartSec=45s
Restart=no
SyslogIdentifier=r8q-usb-route

[Install]
WantedBy=multi-user.target
