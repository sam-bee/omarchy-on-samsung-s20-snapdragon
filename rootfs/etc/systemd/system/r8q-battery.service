[Unit]
Description=r8q battery telemetry and MAX77705 charger (hardware-gated)
# Charger ownership is gated by the adapter/startup preparation and touch
# readiness. A host, configured UDC, gadget, or successful route mutation is
# deliberately not a charger precondition.
Requires=r8q-hardware-prepare.service r8q-touch.service
After=r8q-hardware-prepare.service r8q-touch.service
Before=graphical.target r8q-desktop.service r8q-audio-start.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/systemctl is-active --quiet r8q-hardware-prepare.service
ExecStartPre=/usr/bin/systemctl is-active --quiet r8q-touch.service
ExecStart=/usr/local/sbin/r8q-battery-up.sh
RemainAfterExit=yes
# The USB wait and six bounded probe waits can total 165 seconds. Leave
# additional time for module insertion and receipt capture before timing out.
TimeoutStartSec=240s
Restart=no

[Install]
WantedBy=multi-user.target
