# OPTIONAL encryption prerequisite fragment for the Linux 7.1.2 r8q kernel.
#
# This file is intentionally not referenced by scripts/build_kernel.sh or any
# default merge. It only makes the kernel-side AES-XTS/device-mapper choices
# explicit for a future disposable candidate. It does not provide cryptsetup,
# an initramfs, a passphrase UI, a LUKS header, or a root handoff.
#
# Kconfig source checked in the matching source snapshot:
# drivers/md/Kconfig:224-240,294-315
# crypto/Kconfig:357-362,649-653,676-680,736-740
# arch/arm64/crypto/Kconfig:17-23

# Device-mapper core and the encrypted target must be available before root.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y

# LUKS2's initial data mode for this plan is aes-xts. Keep the generic AES
# implementation built in as a fallback and the ARMv8 Crypto Extensions
# implementation built in so no provider is needed as a post-root module.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# DM_CRYPT selects CRYPTO, CRYPTO_CBC, CRYPTO_ESSIV, CRYPTO_LIB_AES, and
# CRYPTO_LIB_MD5; XTS selects CRYPTO_SKCIPHER, CRYPTO_MANAGER, and CRYPTO_ECB;
# the ARM64 block implementation selects CRYPTO_SKCIPHER, CRYPTO_LIB_AES, and
# CRYPTO_LIB_SHA256. They are intentionally left to Kconfig selection rather
# than duplicated as independent policy choices here.
