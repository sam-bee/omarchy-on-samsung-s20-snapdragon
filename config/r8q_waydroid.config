# OPTIONAL Waydroid 1.6.3 kernel candidate for Linux 7.1.2.
#
# This fragment is intentionally not included by scripts/build_kernel.sh and
# must be merged only into a separately reviewed candidate.  It is based on
# out/kernel-rtc-offset-20261009/.config.  It does not change the accepted
# kernel, source tree, build outputs, modules, boot entries, or phone state.
#
# Source checked in:
#   drivers/android/Kconfig and drivers/android/Makefile
#   init/Kconfig (PSI)
#   net/netfilter/Kconfig and net/ipv{4,6}/netfilter/Kconfig
#   drivers/dma-buf/Kconfig

# Android Binder is a bool in this source and is linked into vmlinux/Image;
# binderfs is the per-container allocator used by Waydroid.  An empty default
# device list leaves binderfs to allocate binder, hwbinder, and vndbinder.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""

# Android/Waydroid memory path.  This is already enabled in the accepted
# config; retain it explicitly so a candidate merge cannot drop memfd_create.
CONFIG_MEMFD_CREATE=y

# Enable pressure accounting and keep it active at boot.  PSI_DEFAULT_DISABLED
# would require psi=1 on the command line, so leave that gate off.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# Keep the accepted LXC network and filesystem choices as modules.  Their
# selected dependencies are resolved by Kconfig when this optional fragment is
# merged; no module is made built-in here.
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_OVERLAY_FS=m

# Waydroid's native nftables helper creates an inet filter table/forward chain
# and an IPv4 nat POSTROUTING chain with a counter/masquerade rule.
# UDP/TCP port sets {53, 67} use nf_tables' built-in payload/meta/set
# expressions; nft_counter.o is also built into nf_tables by its Makefile.
# NAT uses the conntrack provider implicitly.
# Keep the existing conntrack module and add only the NAT/nftables closure.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m

# No speculative Android graphics/debug additions:
#   * accepted CONFIG_SYNC_FILE=y and CONFIG_UDMABUF=y remain available for
#     the existing dma-buf path; SW_SYNC is a DEBUG_FS validation/test
#     facility, not a Waydroid runtime requirement, and remains unset.
#   * accepted CONFIG_FUSE_FS=m is retained for generic userspace filesystems;
#     the planned LXC path uses kernel overlayfs, so FUSE is not promoted or
#     otherwise changed by this fragment.
